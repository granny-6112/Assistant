{
  "name": "assistant",
  "version": "0.7.5",
  "description": "A screen assistant that hides at the top of your screen: Gemini, Claude or an offline Gemma model",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win --dir",
    "release": "electron-builder --win nsis --publish always"
  },
  "author": "Denis",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fugood/llama.node": "^1.7.15",
    "@google/genai": "^2.32.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "katex": "^0.16.47",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@nut-tree-fork/libnut-linux": "2.7.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Assistant",
  "build": {
    "appId": "app.assistant.desktop",
    "productName": "Assistant",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/{test,tests,docs,example,examples}/**",
      "!node_modules/@fugood/node-llama-linux*/**",
      "!node_modules/@fugood/node-llama-wasm/**",
      "!node_modules/@fugood/llama.node/src/**",
      "!node_modules/@fugood/llama.node/**/*.ts",
      "!node_modules/@nut-tree-fork/libnut-win32/build/Release/*.{lib,exp}",
      "!node_modules/@nut-tree-fork/libnut-linux/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Assistant",
      "artifactName": "Assistant-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Assistant-${version}-portable.exe"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "granny-6112",
        "repo": "Assistant",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/libnut-win32/build/Release/**"
    ]
  },
  "optionalDependencies": {
    "@fugood/node-llama-win32-x64": "^1.7.15",
    "@fugood/node-llama-win32-x64-vulkan": "^1.7.15",
    "@nut-tree-fork/libnut-win32": "2.7.5",
    "uiohook-napi": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/granny-6112/Assistant.git"
  }
}
